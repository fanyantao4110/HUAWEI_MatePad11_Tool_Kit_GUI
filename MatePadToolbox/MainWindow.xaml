<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MatePadToolbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="华为MatePad 11 综合工具箱">

    <Grid>
        <NavigationView x:Name="NavView"
                        Loaded="NavView_Loaded"
                        ItemInvoked="NavView_ItemInvoked"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        Header="">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="home" Content="主页" Icon="Home"/>
                <NavigationViewItem Tag="driver" Content="安装驱动程序">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F1;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="backup9008" Content="9008备份">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C9;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="unlock" Content="解锁BL">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE785;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="root" Content="Root">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7EF;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="download" Content="下载第三方系统/底包" Icon="Download"/>
                <NavigationViewItem Tag="flash" Content="刷入第三方系统">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE777;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="official" Content="刷官方系统(救砖)">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77C;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="downgrade" Content="降级系统/回锁BL">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74B;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="console" Content="ADB命令行">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE756;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="devmgr" Content="设备管理器">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE770;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <ScrollViewer>
                <Frame x:Name="ContentFrame" Padding="24,12,24,24"/>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
