<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MatePadToolbox.Pages.Backup9008Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MatePadToolbox.Controls"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <controls:TroubleshootButton FeatureKey="backup9008" FeatureName="9008备份" HorizontalAlignment="Left"/>

        <TextBlock Text="9008备份" FontSize="24" FontWeight="Bold"/>
        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                 Title="警告"
                 Message="本工具仅支持设备型号为 DBY-W09 使用！回读全分区需要在 9008 模式下执行，回读过程请勿断开数据线。"/>

        <TextBlock TextWrapping="Wrap" Opacity="0.8" LineHeight="22"
                   Text="通过 9008 模式回读设备全部分区镜像，生成 images（分区镜像）、gpt_and_xml（分区表与 rawprogram XML）和 flash_all.bat（一键线刷脚本）。与原高通工具箱脚本一致：userdata、last_parti 等超大/特殊分区默认不回读。"/>

        <TextBlock Text="保存目录" FontWeight="SemiBold"/>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SavePathBox" Grid.Column="0" PlaceholderText="选择备份保存目录"/>
            <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览..." Click="BrowseFolder_Click" MinWidth="90"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="BtnStart" Content="回读全分区" Click="StartBackup_Click"
                    Style="{StaticResource AccentButtonStyle}" MinWidth="140"/>
            <Button x:Name="BtnCancel" Content="取消" Click="Cancel_Click" IsEnabled="False"/>
            <Button x:Name="BtnOpenBackup" Content="打开备份目录" Click="OpenBackupDir_Click"/>
        </StackPanel>

        <controls:LogPanel x:Name="Log" Height="320"/>
    </StackPanel>
</Page>
